# Credentials for the LiveKit token endpoint.
#
# These are read on the SERVER only (server/livekitToken.js). Vite only exposes
# VITE_-prefixed variables to the browser bundle, so nothing here can leak into it
# even by accident - the API secret is never in the bundle.
#
# Copy to .env and fill in. Get the first three from your LiveKit project settings:
# https://cloud.livekit.io

LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
LIVEKIT_URL=wss://your-project.livekit.cloud

# Which agent to dispatch into the room. Without it the room opens and nothing
# answers in it, which is a valid but quiet deployment.
LIVEKIT_AGENT_NAME=

# Optional: metadata handed to the agent when it is dispatched.
LIVEKIT_AGENT_METADATA=

# Optional: prefix for the room names the endpoint mints (default: portal).
LIVEKIT_ROOM_PREFIX=

# Optional: grant lifetime (default: 10m).
LIVEKIT_TOKEN_TTL=

# Optional: point the browser at a token service on another host. It is then
# called directly, so that service must allow this origin via CORS.
# VITE_LIVEKIT_TOKEN_ENDPOINT=https://tokens.example.com/api/livekit/token
